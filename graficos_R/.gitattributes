# o ZIP do programa é gerado a partir desta pasta: os .bat/.cmd/.vbs precisam sair com quebras de linha do Windows (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
# o ZIP leva só o PDF do manual (Manual_Cinabro.pdf); os arquivos-fonte (HTML e prints) ficam no repositório
manual export-ignore
planejamento export-ignore
